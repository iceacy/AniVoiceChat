# LLM配置
LLM_PROVIDER=glm  # deepseek 或 glm
GLM_API_KEY=your_glm_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash

# 模型路径配置
QWEN_ASR_MODEL_PATH=D:/Vscode_Program/AniVoiceChat/models/qwen3-asr-0.6b
GPT_SOVITS_ROOT=D:/Vscode_Program/GPT-SoVITS
DEFAULT_CHARACTER=妮露_JA

# 设备配置
DEVICE=cuda  # cuda 或 cpu

# 音频配置
SAMPLE_RATE=16000
CHUNK_SIZE=1024

# 语言映射配置（根据LLM回复语言自动切换TTS角色）
# 配置后，当检测到对应语言的回复时，会使用指定角色的模型进行语音合成
LANG_MAP_ZH=时雨绮罗_ZH  # 中文回复使用的角色
LANG_MAP_JA=妮露_JA      # 日文回复使用的角色
LANG_MAP_EN=             # 英文回复使用的角色（留空表示不启用）
